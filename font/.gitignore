# 本目录仅跟踪模板实际使用的字体文件（清单见 font/README.md）。
# 以下为本地字体资料 / 商业字体，不入库：

# 数学字体资料库（选型参考用）
mathfonts/

# Fandol 盲文字体（未使用）
fandolfonts/FandolBraille-*.otf

# 思源黑体：仅用 Regular/Bold
englishfonts/SourceHanSansCN-ExtraLight.otf
englishfonts/SourceHanSansCN-Heavy.otf
englishfonts/SourceHanSansCN-Light.otf
englishfonts/SourceHanSansCN-Medium.otf
englishfonts/SourceHanSansCN-Normal.otf

# 思源宋体（未使用）
englishfonts/SourceHanSerifCN-*.otf
englishfonts/SourceHanSerifSC-*.otf

# 商业字体（请勿公开分发）
englishfonts/TimesNewRoman*.ttf

# JetBrains Mono：仅用 Regular/Bold/Italic/BoldItalic
englishfonts/JetBrainsMonoNL-*.ttf
englishfonts/JetBrainsMono-ExtraBold*.ttf
englishfonts/JetBrainsMono-ExtraLight*.ttf
englishfonts/JetBrainsMono-Light*.ttf
englishfonts/JetBrainsMono-Medium*.ttf
englishfonts/JetBrainsMono-SemiBold*.ttf
englishfonts/JetBrainsMono-Thin*.ttf
